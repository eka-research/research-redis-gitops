[mysqld]
# Sized for local kind development, not production.
innodb_buffer_pool_size = 256M
max_connections = 100
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
skip-name-resolve
# Turn binlog off for now. Turn it back on (ROW format) for the CDC/Debezium research track.
disable_log_bin
